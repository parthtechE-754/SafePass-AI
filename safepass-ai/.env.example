# ── Map & Geodata (100% Free Defaults: ArcGIS & Open-Meteo) ─────────────────
MAPBOX_ACCESS_TOKEN=pk.optional_token_if_using_mapbox
OPENWEATHERMAP_API_KEY=optional_key_if_using_owm

# ── Supabase Cloud Database (Free tier at https://supabase.com) ─────────────
# 1. Create a free project at https://supabase.com
# 2. Run the SQL script from `supabase_schema.sql` in your Supabase SQL Editor
# 3. Paste your project URL and public anon key below:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
